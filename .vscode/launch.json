{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Zephyr Native Sim Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "/workspace/applications/tetrimini/build/zephyr/zephyr.exe",
            "args": ["--seed-random"],
            "stopAtEntry": false,
            "cwd": "/workspace/applications/tetrimini",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "West Build Native Sim"
        }
    ]
}
